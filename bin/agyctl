SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

PERSONA_SCRIPT="$DIR/../scripts/persona_manager.py"
PLUGINS_SCRIPT="$DIR/../scripts/update_plugins.py"

case "$1" in
    # Persona commands
    persona)
        shift
        python3 "$PERSONA_SCRIPT" "$@"
        ;;
    switch)
        shift
        python3 "$PERSONA_SCRIPT" switch "$@"
        ;;
    current|status)
        python3 "$PERSONA_SCRIPT" current
        ;;
    list|personas)
        python3 "$PERSONA_SCRIPT" list
        ;;
    reset)
        python3 "$PERSONA_SCRIPT" reset
        ;;
    load)
        shift
        python3 "$PERSONA_SCRIPT" load "$@"
        ;;
    unload)
        shift
        python3 "$PERSONA_SCRIPT" unload "$@"
        ;;

    # Plugin commands
    plugins|plugin)
        shift
        python3 "$PLUGINS_SCRIPT" "$@"
        ;;
    check)
        shift
        python3 "$PLUGINS_SCRIPT" check "$@"
        ;;
    update)
        shift
        python3 "$PLUGINS_SCRIPT" update "$@"
        ;;

    version|--version|-v)
        echo "agyctl (Antigravity Control) v1.0.0"
        ;;

    *)
        echo -e "\033[1;35magyctl - Antigravity Control CLI\033[0m"
        echo "Usage: agyctl <command> [args...]"
        echo ""
        echo "Persona & Context Commands:"
        echo "  agyctl switch <name>             Switch active persona (core, architect, fullstack, stitch, gcp-sre, adk-dev)"
        echo "  agyctl current                   Show active persona, loaded skills, and enabled plugins"
        echo "  agyctl list                      List all available persona profiles"
        echo "  agyctl reset                     Reset to minimal core persona (< 5 skills)"
        echo "  agyctl load <name>               Temporarily load an individual skill or plugin"
        echo "  agyctl unload <name>             Temporarily unload a skill or plugin"
        echo ""
        echo "Plugin & Update Commands:"
        echo "  agyctl check                     Audit installed plugins against upstream GitHub & Git remotes"
        echo "  agyctl update [name|all]         Update outdated plugins to latest upstream releases"
        echo "  agyctl plugins list              List installed plugin manifests and local versions"
        echo ""
        echo "Examples:"
        echo "  agyctl switch stitch             # Load Google Stitch UI/UX design suite"
        echo "  agyctl switch architect          # Load Bean-to-Cup SDLC & Red-Teaming tools"
        echo "  agyctl reset                     # Revert to lightweight daily coding baseline"
        echo "  agyctl check                     # Verify plugin freshness"
        echo "  agyctl update all                # Update all outdated plugins"
        echo ""
        exit 0
        ;;
esac
